# Server Environment Variables
# Copy this file to .env and fill in the values.

NODE_ENV=development
PORT=8000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000

# ── Postgres ────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=10xcoder-server
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ── Redis ───────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Better Auth ─────────────────────────────────
BETTER_AUTH_SECRET=replace-with-a-32+-char-secret
API_URL=http://localhost:8000

# ── GitHub OAuth ────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Autosend (email) ────────────────────────────
AUTOSEND_API_KEY=
DOMAIN=yourdomain.com

# ── ImageKit ────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_cloud_id
CDN_URL=https://ik.imagekit.io/your_cloud_id

# ── Logflare (production only) ──────────────────
LOGFLARE_API_KEY=
LOGFLARE_SOURCE_ID=

# ── Sentry (production only) ────────────────────
SENTRY_DSN=
