NEXT_PUBLIC_CDN_URL=https://ik.imagekit.io/your_cloud_id
NEXT_PUBLIC_GA_MEASUREMENT_ID="Your-G-XXXXXXXXXX-ID"
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
API_URL=http://localhost:4000
